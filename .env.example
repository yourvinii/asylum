# ─────────────────────────────────────────────
# HAVEN – Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file.
# ─────────────────────────────────────────────

# ── Server ────────────────────────────────────
PORT=8080
NODE_ENV=development

# ── Database ──────────────────────────────────
# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/haven

# ── Authentication ────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# ── CORS ──────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── AI provider (optional) ────────────────────
# Required for: AI Rental Assistant, NL search, recommendations, listing drafts (Chunks 11-13)
# Leave empty to run the app without AI features.
AI_PROVIDER_API_KEY=
AI_MODEL=

# ── Email (optional) ──────────────────────────
# Required for: OTP verification and transactional email (Chunk 4)
# Leave empty during early development; OTPs will be logged to the console instead.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=you@example.com
EMAIL_PASSWORD=your_email_password

# ── Storage ───────────────────────────────────
# local  → files saved to server/uploads/ (development default)
# s3     → S3-compatible storage (future)
STORAGE_PROVIDER=local

# ─────────────────────────────────────────────
# Frontend (Vite) – PUBLIC variables
# These are bundled into the browser build.
# Never put secrets, DB credentials, or AI keys here.
# ─────────────────────────────────────────────

# Base URL for all frontend → backend API calls
VITE_API_BASE_URL=http://localhost:8080/api

# Mapbox public token (restricted to your domain in production)
# Required for: property map and location search (Chunk 5)
VITE_MAPBOX_TOKEN=
